#!/usr/bin/env xdg-open
[Desktop Entry]
Comment[en_US]=
Comment=
Exec=bash -c 'if [ -f "$HOME/DeckOps-Nightly/launcher.sh" ]; then bash "$HOME/DeckOps-Nightly/launcher.sh"; else TMPDIR_DO=$(mktemp -d /tmp/deckops_XXXXXX) || exit 1; curl -fsSL --connect-timeout 15 --max-time 120 https://raw.githubusercontent.com/smeltzzz/DeckOps-Nightly/main/launcher.sh -o "$TMPDIR_DO/launcher.sh" && bash "$TMPDIR_DO/launcher.sh"; rm -rf "$TMPDIR_DO"; fi'
GenericName[en_US]=
GenericName=
MimeType=
Name[en]=DeckOps Nightly
Name=DeckOps Nightly
Path=
StartupNotify=false
Terminal=true
TerminalOptions=
Type=Application
X-DBUS-ServiceName=
X-DBUS-StartupType=
X-KDE-SubstituteUID=false
X-KDE-Username=
