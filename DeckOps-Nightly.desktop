#!/usr/bin/env xdg-open
[Desktop Entry]
Comment[en_US]=
Comment=
Exec=bash -c 'if [ -f "$HOME/DeckOps-Nightly/launcher.sh" ]; then bash "$HOME/DeckOps-Nightly/launcher.sh"; else TMPFILE=$(mktemp /tmp/deckops_XXXXXX.sh) && curl -fsSL https://raw.githubusercontent.com/smeltzzz/DeckOps-Nightly/main/launcher.sh -o "$TMPFILE" && bash "$TMPFILE"; rm -f "$TMPFILE"; fi'
GenericName[en_US]=
GenericName=
MimeType=
Name[en]=DeckOps Nightly
Name=DeckOps Nightly
Path=
StartupNotify=false
Terminal=true
TerminalOptions=
Type=Application
X-DBUS-ServiceName=
X-DBUS-StartupType=
X-KDE-SubstituteUID=false
X-KDE-Username=
